# DroneWatch Environment Configuration Example
# Copy this file to `.env` for local execution. DO NOT commit `.env` to version control.

# Application Mode
DRONEWATCH_APP_NAME="DroneWatch"
DRONEWATCH_ENVIRONMENT="development"
DRONEWATCH_DEBUG=true

# Google Cloud Platform Settings
DRONEWATCH_GCP_PROJECT_ID="your-gcp-project-id"
DRONEWATCH_GCP_LOCATION="us-central1"
DRONEWATCH_USE_VERTEX_AI=true
DRONEWATCH_GEMINI_MODEL="gemini-3.6-flash"

# Storage & Database Settings
DRONEWATCH_GCS_BUCKET_VIDEOS="your-dronewatch-videos-bucket"
DRONEWATCH_GCS_BUCKET_SNAPSHOTS="your-dronewatch-snapshots-bucket"
DRONEWATCH_ALLOYDB_HOST=""
DRONEWATCH_ALLOYDB_PORT=5432
DRONEWATCH_ALLOYDB_USER="postgres"
DRONEWATCH_ALLOYDB_PASSWORD="CHANGE_ME_IN_PRODUCTION"
DRONEWATCH_ALLOYDB_DATABASE="dronewatch_db"

# Stream Ingestion Parameters
DRONEWATCH_MAX_CONCURRENT_STREAMS=4
DRONEWATCH_FRAME_SAMPLING_FPS=1.0
DRONEWATCH_MOTION_SENSITIVITY_THRESHOLD=15.0
DRONEWATCH_MIN_MOTION_AREA=500
DRONEWATCH_SAMPLE_VIDEO_PATH="/path/to/sample/video.mp4"
