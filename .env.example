# DroneWatch Environment Configuration

# Server Ports
PORT=4000
FRONTEND_PORT=3000

# Database Configuration (Local PostgreSQL / Cloud AlloyDB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dronewatch
DB_USER=dronewatch
DB_PASSWORD=dronewatch_secret
DB_SSL=false

# MediaMTX RTSP Server
RTSP_HOST=localhost
RTSP_PORT=8554
MEDIAMTX_API=http://localhost:8554/v3

# Google Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Platform (for GCP Cloud Deployment mode)
GCP_PROJECT_ID=dronewatch-project
GCP_REGION=us-central1
PUBSUB_TOPIC_ALERTS=dronewatch-urgent-alerts
GCS_BUCKET_MEDIA=dronewatch-media-archive
GCS_BUCKET_SIMULATION=dronewatch-simulation-videos

# Execution Mode: 'local' or 'gcp'
APP_ENV=local
